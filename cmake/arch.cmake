if (CMAKE_SYSTEM_PROCESSOR MATCHES "amd64|x86_64")
    if (CMAKE_LIBRARY_ARCHITECTURE MATCHES "i386")
        message(FATAL_ERROR "32bit platforms are not supported")
    endif ()
    set(ARCH_AMD64 1)
elseif (CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64.*|AARCH64.*|arm64.*|ARM64.*)")
    set(ARCH_AARCH64 1)
elseif (CMAKE_SYSTEM_PROCESSOR MATCHES "^(powerpc64le.*|ppc64le.*|PPC64LE.*)")
    set(ARCH_PPC64LE 1)
elseif (CMAKE_SYSTEM_PROCESSOR MATCHES "^(s390x.*|S390X.*)")
    set(ARCH_S390X 1)
elseif (CMAKE_SYSTEM_PROCESSOR MATCHES "riscv64")
    set(ARCH_RISCV64 1)
elseif (CMAKE_SYSTEM_PROCESSOR MATCHES "loongarch64")
    set(ARCH_LOONGARCH64 1)
else ()
    message(FATAL_ERROR "Platform ${CMAKE_SYSTEM_PROCESSOR} is not supported")
endif ()

# 检测编译器类型并设置警告即错误。
# 只作用于 C/CXX: nvcc 有自己的 -Werror(带值选项), 把宿主编译器的 -Werror
# 原样传过去会被它当成 "-Werror <value>", 把后面的 -MD 吃掉直接 fatal。
if (CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
    add_compile_options($<$<COMPILE_LANGUAGE:C,CXX>:-Werror>)
elseif (CMAKE_CXX_COMPILER_ID MATCHES "MSVC")
    add_compile_options($<$<COMPILE_LANGUAGE:C,CXX>:/WX>)
endif ()